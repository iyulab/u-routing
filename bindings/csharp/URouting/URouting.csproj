<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>URouting</RootNamespace>
    <AssemblyName>URouting</AssemblyName>
    <PackageId>URouting</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>0.10.0</Version>
    <Authors>iyulab</Authors>
    <Description>Vehicle routing optimization (TSP, CVRP, VRPTW) — Rust engine with C# bindings.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>

    <!-- Trimmed and NativeAOT hosts: the analyzers fail the build on anything that
         would need reflection at run time. -->
    <IsAotCompatible>true</IsAotCompatible>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2057;IL2060;IL2067;IL2070;IL2072;IL2075;IL2087;IL2091;IL3050;IL3051</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="URouting.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native libraries, one per runtime identifier, placed under runtimes/ by the
         NuGet release workflow; its build matrix is the list of runtimes. -->
    <None Include="runtimes/**/*" Pack="true" PackagePath="runtimes/" />
  </ItemGroup>

</Project>
